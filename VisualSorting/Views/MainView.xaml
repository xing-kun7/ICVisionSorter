<UserControl x:Class="VisualSorting.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VisualSorting.Views"
             xmlns:vm="clr-namespace:VisualSorting.ViewModels"
             xmlns:halcon="clr-namespace:HalconDotNet;assembly=halcondotnet"
            
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf" 
            
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             mc:Ignorable="d" 
             Background="Transparent"
             d:DesignHeight="950" d:DesignWidth="1400">
    <UserControl.DataContext>
        <vm:MainViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <!-- 按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E3A5F"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="3" BorderBrush="#2E5077" BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2E5077"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0F2847"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#6B6B6B"/>
                                <Setter Property="Foreground" Value="#9E9E9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 灰色按钮样式 -->
        <Style x:Key="GrayWhiteButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#37474F"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="3" BorderBrush="#455A64" BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#455A64"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#263238"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#6B6B6B"/>
                                <Setter Property="Foreground" Value="#9E9E9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 成功按钮样式 -->
        <Style x:Key="SuccessButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="3" BorderBrush="#2E7D32" BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2E7D32"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0D3A0F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#6B6B6B"/>
                                <Setter Property="Foreground" Value="#9E9E9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险按钮样式 -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8B1A1A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="3" BorderBrush="#B71C1C" BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#B71C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#5D0A0A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#6B6B6B"/>
                                <Setter Property="Foreground" Value="#9E9E9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 面板样式 -->
        <Style x:Key="ModernPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#9E9E9E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 数据卡片样式 -->
        <Style x:Key="DataCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#D0D0D0"/>
            <Setter Property="BorderBrush" Value="#9E9E9E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- 模块标题栏样式 -->
        <Style x:Key="ModuleHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="#37474F"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- 模块标题文字样式 -->
        <Style x:Key="ModuleTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 模块图标容器样式 -->
        <Style x:Key="ModuleIconBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="#455A64"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- 模块图标文字样式 -->
        <Style x:Key="ModuleIconTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 斜方块导航按钮样式 -->
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0D47A1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Polygon x:Name="ButtonShape" 
                                     Points="8,0 100,0 92,32 0,32"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="#1565C0"
                                     StrokeThickness="1.5"
                                     Stretch="Fill"
                                     Width="100"
                                     Height="32"/>
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonShape" Property="Fill" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonShape" Property="Fill" Value="#0A3D91"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonShape" Property="Fill" Value="#6B6B6B"/>
                                <Setter Property="Foreground" Value="#9E9E9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 主布局 -->
        <Grid Background="#C8C8C8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <Border Grid.Row="0" Background="#08316B" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 系统标题和logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0">

                        <TextBlock Text="IC芯片分拣系统" 
                               Foreground="White" FontSize="18" FontWeight="Bold"
                               VerticalAlignment="Center"/>

                        <!-- 分隔符 -->
                        <TextBlock Text="" 
                               Foreground="#4A90E2" FontSize="18" FontWeight="Normal"
                               VerticalAlignment="Center" Margin="15,0"/>

                        <!-- 当前时间显示 -->
                        <TextBlock Text="{Binding CurrentTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" 
                               Foreground="#E0E0E0" FontSize="16" FontWeight="Medium"
                               VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 中央状态信息 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SystemStatusMessage}" 
                               Foreground="White" FontSize="14" FontWeight="Medium"
                               VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 用户信息和控制按钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,20,0">

                        <!-- 用户信息 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,15,0" Cursor="Hand">

                            <TextBlock Text="操作员:半岛冰茶" 
                                   Foreground="White" FontSize="13" 
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>


                    </StackPanel>
                </Grid>
            </Border>

            <!-- 导航按钮栏 -->
            <Border Grid.Row="1" Background="#0A3D91"  Padding="10,5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BtnMainView" Content="主界面" 
                            Click="BtnMainView_Click"
                            Style="{StaticResource NavigationButtonStyle}"/>
                    <Button x:Name="BtnYoloDetection" Content="YOLO检测" 
                            Click="BtnYoloDetection_Click"
                            Style="{StaticResource NavigationButtonStyle}"/>
                    <Button x:Name="BtnLogout" Content="退出登录" 
                            Click="BtnLogout_Click"
                            Style="{StaticResource NavigationButtonStyle}"/>
                </StackPanel>
            </Border>

            <!-- 主内容区域 -->
            <Grid Grid.Row="2" Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="200"/>
                    <ColumnDefinition Width="5*" MinWidth="400"/>
                    <ColumnDefinition Width="2.5*" MinWidth="250"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧控制面板 -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="21*" MinHeight="180"/>
                        <RowDefinition Height="30*" MinHeight="200"/>
                        <RowDefinition Height="25*" MinHeight="180"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ModernPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource ModuleHeaderStyle}" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource ModuleIconBorderStyle}">
                                            <TextBlock Text="&#xE950;" Style="{StaticResource ModuleIconTextStyle}"/>
                                        </Border>
                                        <TextBlock Text="运动控制" Style="{StaticResource ModuleTitleTextStyle}"/>
                                    </StackPanel>
                                </Border>

                                <Button Content="连接控制卡" Grid.Row="1" Grid.Column="0"
                                Command="{Binding ConnectCommand}" Margin="3"
                                Style="{StaticResource SuccessButtonStyle}"  />

                                <Button Content="电机使能" Grid.Row="1" Grid.Column="1"
                                Command="{Binding SevonCommand}" Margin="3"
                                Style="{StaticResource SuccessButtonStyle}"  />

                                <Button Content="开启传送带" Grid.Row="2" Grid.Column="0"
                                Command="{Binding MoveCommand}" Margin="3"
                                Style="{StaticResource SuccessButtonStyle}"  />

                                <Button Content="关闭传送带" Grid.Row="2" Grid.Column="1"
                                Command="{Binding StopCommand}" Margin="3"
                                Style="{StaticResource SuccessButtonStyle}" Background="DarkRed" />

                                <TextBlock Text="速度(unit/s)：" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" FontSize="12" Margin="3"/>
                                <TextBox Grid.Row="3" Grid.Column="1"
                                                Text="{Binding TargetSpeed,UpdateSourceTrigger=PropertyChanged}" 
                                                     MinWidth="50"
                                                     Margin="3" VerticalAlignment="Center"/>

                                <Button Content="执行调速(重启传送带生效)" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ChangedSpeedCommand}" 
                                        Height=" 25"
                                              Margin="0" />
                            </Grid>

                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource ModernPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource ModuleHeaderStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource ModuleIconBorderStyle}">
                                            <TextBlock Text="&#xE8FD;" Style="{StaticResource ModuleIconTextStyle}"/>
                                        </Border>
                                        <TextBlock Text="视觉模板模块" Style="{StaticResource ModuleTitleTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="绘制芯片模板" Grid.Row="1"
                                Command="{Binding DrawTemplateCommand}"
                                        Height=" 35"
                                 Margin="10 5 10 5 "
                                 Style="{StaticResource SuccessButtonStyle}"  />
                                <Button Content="绘制检测区域一" Grid.Row="2"
                                Command="{Binding DrawCheckRectXidCommand}"  
                                       Height=" 35"
                                        Margin="10 5 10 5 "
                                 Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Content="绘制检测区域二" Grid.Row="3"
                                 Command="{Binding DrawCheckRectXid2Command}"  
                                         Height=" 35"
                                            Margin="10 5 10 5 "
                                  Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Content="保存模板" Grid.Row="4"
                                 Command="{Binding SaveTemplateCommand}"  
                                       Height=" 35"
                                        Margin="10 5 10 5 "
                                  Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Content="调用模板" Grid.Row="5"
                                 Command="{Binding LoadTemplateCommand}"  
                                         Height=" 35"
                                        Margin="10 5 10 5 "
                                  Style="{StaticResource SuccessButtonStyle}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource ModernPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="1.1*"/>
                                    <RowDefinition Height="1.1*"/>
                                    <RowDefinition Height="1.1*"/>
                                    <RowDefinition Height="1.1*"/>
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource ModuleHeaderStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource ModuleIconBorderStyle}">
                                            <TextBlock Text="&#xE960;" Style="{StaticResource ModuleIconTextStyle}"/>
                                        </Border>
                                        <TextBlock Text="相机模块" Style="{StaticResource ModuleTitleTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="打开相机" Grid.Row="1" Command="{Binding OpenCameraCommand}" Margin="3" Style="{StaticResource GrayWhiteButtonStyle}"/>
                                <Button Content="开始检测" Grid.Row="2" Command="{Binding StartLiveCommand}" Margin="3" Style="{StaticResource GrayWhiteButtonStyle}"/>
                                <Button Content="停止检测" Grid.Row="3" Command="{Binding StopLiveCommand}" Margin="3" Style="{StaticResource GrayWhiteButtonStyle}"/>
                                <Button Content="关闭相机" Grid.Row="4" Command="{Binding CloseCameraCommand}" Margin="3" Style="{StaticResource GrayWhiteButtonStyle}" Background="DarkRed"/>
                            </Grid>
                        </Border>

                </Grid>

                <!-- 中央显示区域 -->
                <Grid Grid.Column="1" Margin="10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="9*" MinHeight="100"/>
                        <RowDefinition Height="20*" MinHeight="200"/>
                        <RowDefinition Height="10*" MinHeight="120"/>
                    </Grid.RowDefinitions>
                    <!-- 日志显示面板 -->
                    <Border Grid.Row="0" Style="{StaticResource ModernPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- 日志显示标题栏 -->
                            <Border Grid.Row="0"  Style="{StaticResource ModuleHeaderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border Style="{StaticResource ModuleIconBorderStyle}">
                                            <TextBlock Text="&#xE8FD;" Style="{StaticResource ModuleIconTextStyle}"/>
                                        </Border>
                                        <TextBlock Text="系统日志" Style="{StaticResource ModuleTitleTextStyle}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding LogEntries.Count, StringFormat='共{0}条记录'}" 
                                               FontSize="11" Foreground="#B0BEC5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                </Grid>
                            </Border>
                            <!-- 日志列表 -->
                            <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}" 
                                     Background="#FAFAFA" BorderThickness="0" 
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas, Microsoft YaHei" FontSize="11">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder" Background="Transparent" 
                                                            BorderBrush="#9E9E9E" BorderThickness="0,0,0,1" 
                                                            Padding="8,4" Margin="0">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#C8C8C8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" 
                                                       Foreground="#546E7A" Margin="0,0,8,0" FontSize="10"/>
                                            <Border Grid.Column="1" Background="{Binding LevelColor}" CornerRadius="2" 
                                                    Padding="4,1" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Level}" Foreground="#FFFFFF" FontSize="9" 
                                                           FontWeight="Medium" HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding Message}" 
                                                       Foreground="#455A64" TextWrapping="Wrap" FontSize="11"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <!--可视化区域-->
                    <Border Grid.Row="1" Margin="10 0 10 0" Style="{StaticResource ModernPanelStyle}">
                        <Grid Background="#C8C8C8">
                            <halcon:HWindowControlWPF x:Name="Hsmart" />
                        </Grid>
                    </Border>

                    <!-- 设备状态监视面板 -->
                    <Border Grid.Row="2" Style="{StaticResource ModernPanelStyle}" Margin="0,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 标题栏 -->
                            <Border Grid.Row="0" Background="#37474F" CornerRadius="3,3,0,0" Padding="12,8" Margin="-20,-20,-20,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border Width="24" Height="24" Background="#455A64" CornerRadius="3" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="设备状态监视" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="#1B5E20" CornerRadius="12" Padding="10,3" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="#4CAF50" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#4CAF50" Opacity="0.8"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <TextBlock Text="系统运行中" FontSize="11" Foreground="#A5D6A7" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 状态监控内容区 - 4行2列等分布局 -->
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左侧状态组 -->
                                <Grid Grid.Column="0" Margin="0,0,5,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 控制卡连接状态 -->
                                    <Border Grid.Row="0" Background="#C8C8C8" CornerRadius="3" Padding="8,4" Margin="0,0,0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#546E7A"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#546E7A" Opacity="0.4"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ConnectStatus}" Value="已连接">
                                                                <Setter Property="Fill" Value="#4CAF50"/>
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#4CAF50" Opacity="0.6"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Grid.Column="1" Text="控制卡连接" FontSize="11" Foreground="#546E7A" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Background="#E8F5E9" CornerRadius="3" Padding="6,2" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding ConnectStatus}" FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 电机使能状态 -->
                                    <Border Grid.Row="1" Background="#C8C8C8" CornerRadius="3" Padding="8,4" Margin="0,0,0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#546E7A"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#546E7A" Opacity="0.4"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SevonStatus}" Value="电机使能">
                                                                <Setter Property="Fill" Value="#2196F3"/>
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#2196F3" Opacity="0.6"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Grid.Column="1" Text="电机使能" FontSize="11" Foreground="#546E7A" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Background="#E3F2FD" CornerRadius="3" Padding="6,2" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding SevonStatus}" FontSize="11" FontWeight="SemiBold" Foreground="#1565C0" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 相机状态 -->
                                    <Border Grid.Row="2" Background="#C8C8C8" CornerRadius="3" Padding="8,4" Margin="0,0,0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#546E7A"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#546E7A" Opacity="0.4"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCameraOpen}" Value="True">
                                                                <Setter Property="Fill" Value="#FF9800"/>
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#FF9800" Opacity="0.6"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Grid.Column="1" Text="相机状态" FontSize="11" Foreground="#546E7A" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Background="#FFF3E0" CornerRadius="3" Padding="6,2" Margin="8,0,0,0">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#E65100" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="未连接"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCameraOpen}" Value="True">
                                                                    <Setter Property="Text" Value="已连接"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 采集状态 -->
                                    <Border Grid.Row="3" Background="#C8C8C8" CornerRadius="3" Padding="8,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#546E7A"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#546E7A" Opacity="0.4"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGrabbing}" Value="True">
                                                                <Setter Property="Fill" Value="#E91E63"/>
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#E91E63" Opacity="0.6"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Grid.Column="1" Text="采集状态" FontSize="11" Foreground="#546E7A" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Background="#FCE4EC" CornerRadius="3" Padding="6,2" Margin="8,0,0,0">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#C2185B" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="未采集"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGrabbing}" Value="True">
                                                                    <Setter Property="Text" Value="采集中"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- 中间分隔线 -->
                                <Border Grid.Column="1" Width="1" Background="#9E9E9E" Margin="10,5"/>

                                <!-- 右侧状态组 -->
                                <Grid Grid.Column="2" Margin="5,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 推料机构状态 -->
                                    <Border Grid.Row="0" Background="#C8C8C8" CornerRadius="3" Padding="8,4" Margin="0,0,0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#546E7A"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#546E7A" Opacity="0.4"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Solendio}" Value="推料机构触发">
                                                                <Setter Property="Fill" Value="#F44336"/>
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#F44336" Opacity="0.6"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Grid.Column="1" Text="推料机构" FontSize="11" Foreground="#546E7A" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Background="#FFEBEE" CornerRadius="3" Padding="6,2" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Solendio}" FontSize="11" FontWeight="SemiBold" Foreground="#C62828" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 电机运动状态 -->
                                    <Border Grid.Row="1" Background="#C8C8C8" CornerRadius="3" Padding="8,4" Margin="0,0,0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#546E7A"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#546E7A" Opacity="0.4"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MoveStatus}" Value="传送带运动">
                                                                <Setter Property="Fill" Value="#9C27B0"/>
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#9C27B0" Opacity="0.6"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Grid.Column="1" Text="电机运动" FontSize="11" Foreground="#546E7A" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Background="#F3E5F5" CornerRadius="3" Padding="6,2" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding MoveStatus}" FontSize="11" FontWeight="SemiBold" Foreground="#7B1FA2" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 传感器状态 -->
                                    <Border Grid.Row="2" Background="#C8C8C8" CornerRadius="3" Padding="8,4" Margin="0,0,0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#546E7A"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#546E7A" Opacity="0.4"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SMCinbit0}" Value="芯片经过（触发中断）">
                                                                <Setter Property="Fill" Value="#00BCD4"/>
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#00BCD4" Opacity="0.6"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Grid.Column="1" Text="传感器" FontSize="11" Foreground="#546E7A" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Background="#E0F7FA" CornerRadius="3" Padding="6,2" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding SMCinbit0}" FontSize="11" FontWeight="SemiBold" Foreground="#00838F" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 检测结果 -->
                                    <Border Grid.Row="3" Background="#C8C8C8" CornerRadius="3" Padding="8,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#546E7A"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#546E7A" Opacity="0.4"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DetectionStatus}" Value="OK">
                                                                <Setter Property="Fill" Value="#4CAF50"/>
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#4CAF50" Opacity="0.6"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DetectionStatus}" Value="NG">
                                                                <Setter Property="Fill" Value="#F44336"/>
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#F44336" Opacity="0.6"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Grid.Column="1" Text="检测结果" FontSize="11" Foreground="#546E7A" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Background="#ECEFF1" CornerRadius="3" Padding="6,2" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding DetectionStatus}" FontSize="11" FontWeight="SemiBold" Foreground="#455A64" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 右侧数据面板 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="23*" MinHeight="150"/>
                        <RowDefinition Height="35*" MinHeight="200"/>
                        <RowDefinition Height="15*" MinHeight="100"/>
                    </Grid.RowDefinitions>
                    <!-- 检测数据趋势面板 -->
                    <Border Grid.Row="0" Style="{StaticResource ModernPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 检测数据趋势标题栏 -->
                                <Border Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource ModuleIconBorderStyle}">
                                            <TextBlock Text="&#xE9D9;" Style="{StaticResource ModuleIconTextStyle}"/>
                                        </Border>
                                        <TextBlock Text="检测数据趋势" Style="{StaticResource ModuleTitleTextStyle}"/>
                                    </StackPanel>
                                </Border>

                                <!-- 折线图核心控件 -->
                                <lvc:CartesianChart 
                                     Grid.Row="1"
                                         Series="{Binding InspectionSeries}"
                                          DisableAnimations="False"
                                              LegendLocation="Top"
                                              FontSize="10">

                                    <!-- X轴（时间轴）配置 -->
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis 
                                          Labels="{Binding TimeLabels}"
                                            FontSize="10"
                                              ShowLabels="True"
                                              Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"
                                             LabelsRotation="0"/>
                                    </lvc:CartesianChart.AxisX>

                                    <!-- Y轴（数量轴）配置 -->
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis 
                                             LabelFormatter="{Binding YAxisFormatter}"
                                             FontSize="10"
                                              MinValue="0"
                                             Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                            </Grid>



                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource ModernPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 实时检测记录标题栏 -->
                                <Border Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource ModuleIconBorderStyle}">
                                            <TextBlock Text="&#xE8FD;" Style="{StaticResource ModuleIconTextStyle}"/>
                                        </Border>
                                        <TextBlock Text="实时检测记录" Style="{StaticResource ModuleTitleTextStyle}"/>
                                    </StackPanel>
                                </Border>

                                <!-- 内容区 -->
                                <DataGrid Grid.Row="1" Margin="0,0,0,0"
                                     ItemsSource="{Binding InspectionRecords}"
                                              IsReadOnly="True"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                         CanUserDeleteRows="False"
                                          CanUserResizeColumns="False"
                                              CanUserSortColumns="False"
                                         CanUserReorderColumns="False"
                                            FontSize="12"
                                                  RowHeight="22"
                                          ColumnHeaderHeight="28"
                                      VerticalScrollBarVisibility="Auto"
                                               HorizontalScrollBarVisibility="Disabled"
                                         GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="检测时间" Binding="{Binding InspectionTime,StringFormat=HH:mm:ss}" Width="70"/>
                                        <DataGridTextColumn Header="芯片型号" Binding="{Binding ProductModel}" Width="75"/>
                                        <DataGridTextColumn Header="结果" Binding="{Binding QualifiedCount, Converter={StaticResource ResultToTextConverter}}" Width="50">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding QualifiedCount}" Value="1">
                                                            <Setter Property="Foreground" Value="Green"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DefectiveCount}" Value="1">
                                                            <Setter Property="Foreground" Value="Red"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="不良原因" Binding="{Binding DefectReasons}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    <Setter Property="ToolTip" Value="{Binding DefectReasons}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource ModernPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 系统信息标题栏 -->
                                <Border Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource ModuleIconBorderStyle}">
                                            <TextBlock Text="&#xE9D9;" Style="{StaticResource ModuleIconTextStyle}"/>
                                        </Border>
                                        <TextBlock Text="系统信息" Style="{StaticResource ModuleTitleTextStyle}"/>
                                    </StackPanel>
                                </Border>

                                <!-- 内容区 -->
                                <Grid Grid.Row="1" Margin="0,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU使用率:"
               FontSize="12" Foreground="#555"/>
                                    <ProgressBar Grid.Row="0" Grid.Column="1"
                 Value="{Binding SystemStatus.CpuUsage,Mode=OneWay}"
                 Maximum="100" Height="8"
                 Background="#C8C8C8" BorderThickness="0"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="内存使用率:"
               FontSize="12" Foreground="#555" Margin="0,8,0,0"/>
                                    <ProgressBar Grid.Row="1" Grid.Column="1"
                 Value="{Binding SystemStatus.MemoryUsage,Mode=OneWay}"
                 Maximum="100" Height="8" Margin="0,8,0,0"
                 Background="#C8C8C8" BorderThickness="0"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="系统运行时间:"
               FontSize="12" Foreground="#555" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" 
               Text="{Binding SystemStatus.RunningTime,Mode=OneWay}"
               FontSize="12" FontWeight="SemiBold"
               Margin="0,8,0,0" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Border>
                </Grid>
            </Grid>

            <!-- 底部状态栏 -->
            <Border Grid.Row="3" Background="#C8C8C8" BorderBrush="#9E9E9E" 
                BorderThickness="1,0,0,0" Padding="15,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="© 2026.4.1   基于WPF与PC-based的IC芯片分拣系统 2.0版本 - 所有权利保留          邮箱:1816301413@qq.com                                                                                                                                        指导老师：杨龙，严勇，贾小龙" 
                          
                               Foreground="#555" FontSize="15"/>


                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
