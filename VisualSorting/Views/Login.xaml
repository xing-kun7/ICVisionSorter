                </Border>
                
                <Border x:Name="CornerAccent2" Grid.Row="6" Width="70" Height="70" 
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-15,-15,0" Opacity="0.25"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Ellipse Width="30" Height="30" Fill="#9E9E9E" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.15" Color="#9E9E9E"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard Storyboard="{StaticResource PulseAnimation}"/>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>
                
            </Grid>
        </Border>
    </Grid>
</UserControl>
