<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   
    <Style x:Key="FloatingBubblesBackground" TargetType="Canvas">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFE6F7FF" Offset="0"/>
                    <GradientStop Color="#FF87CEEB" Offset="0.5"/>
                    <GradientStop Color="#FFB0E2FF" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FloatingBubble" TargetType="Ellipse">
        <Setter Property="Fill" Value="#20FFFFFF"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Style.Triggers>
            <Trigger Property="AllowDrop" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- 浮动动画 -->
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Canvas.Left)">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:4" Value="100"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:8" Value="0"/>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Canvas.Top)">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:2" Value="50"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="-30"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:8" Value="0"/>
                            </DoubleAnimationUsingKeyFrames>
                            <!-- 缩放动画 -->
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:4" Value="1.2"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:8" Value="1"/>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:4" Value="1.2"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:8" Value="1"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>